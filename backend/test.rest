### 1. INSCRIPTION
POST {{baseUrl}}/register/
Content-Type: application/json

{
    "username": "jean",
    "email": "jean@gmail.com",
    "password": "123456789",
    "profile": {
        "fullname": "Jean Niamien"
    }
}

### 2. CONNEXION
POST {{baseUrl}}/login/
Content-Type: application/json

{
    "email": "jean@gmail.com",
    "password": "123456789"
}

### 3. CONSULTER SON PROFIL
GET {{baseUrl}}/me/
Authorization: Bearer {{accessToken}}

### 4. MODIFIER SON PROFIL
PATCH {{baseUrl}}/me/update/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "fullname": "Jean Niamien",
    "phone": "+2250700000000",
    "country": "Côte d'Ivoire",
    "city": "Abidjan",
    "address": "Cocody",
    "blood": "O_POS"
}

### 5. CONSULTER LA LISTE DES PROFILS
GET {{baseUrl}}/profile_list/
Authorization: Bearer {{accessToken}}

### 6. RENOUVELER LE TOKEN
POST {{baseUrl}}/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

### 7. SE DÉCONNECTER
POST {{baseUrl}}/logout/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

### 8. SUPPRIMER UN UTILISATEUR
DELETE {{baseUrl}}/delete_profile/1/
Authorization: Bearer {{accessToken}}
